# Databáze
POSTGRES_USER=promo
POSTGRES_PASSWORD=zmen_me
POSTGRES_DB=promo
DATABASE_URL=postgresql+psycopg://promo:zmen_me@db:5432/promo

# Bezpečnost JWT
JWT_SECRET=vygeneruj_nahodny_dlouhy_retezec
COOKIE_SECURE=true
JWT_EXPIRE_DAYS=30

# Master účet (seed při prvním startu — po přihlášení okamžitě změňte heslo)
MASTER_LOGIN=master
MASTER_PASSWORD=zmen_me_hned

# Heuristika podezřelosti — noční okno (celé hodiny, Europe/Prague)
NIGHT_WINDOW_START=0
NIGHT_WINDOW_END=6

# Doména pro Caddy (automatické HTTPS přes Let's Encrypt)
# Musí být platná doména s A-záznamem směřujícím na IP tohoto serveru
DOMAIN=kupony.tvojedomena.cz

# Prefix QR kódů na operátorské obrazovce — sdílený backend (config.py)
# i frontend (Vite build čte přes build arg v docker-compose).
# Pro lokální `npm run build` mimo Docker: chybí-li VITE_QR_PREFIX,
# Scan.vue použije fallback 'PROMO'.
QR_PREFIX=PROMO
